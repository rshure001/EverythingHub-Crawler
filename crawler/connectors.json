{
  "version": 1,
  "description": "Ten independent public-web discovery connectors. Each connector reads the publisher's robots.txt sitemap declarations; it does not copy Bing's private index.",
  "limits": {
    "max_sitemaps_per_connector": 4,
    "max_urls_per_connector": 250,
    "max_new_urls_per_run": 2500,
    "max_frontier_urls": 50000,
    "response_bytes": 2000000
  },
  "connectors": [
    {
      "id": "wikipedia",
      "name": "Wikipedia",
      "base_url": "https://www.wikipedia.org/",
      "enabled": true
    },
    {
      "id": "loc",
      "name": "Library of Congress",
      "base_url": "https://www.loc.gov/",
      "enabled": true
    },
    {
      "id": "smithsonian",
      "name": "Smithsonian Institution",
      "base_url": "https://www.si.edu/",
      "enabled": true
    },
    {
      "id": "nasa",
      "name": "NASA",
      "base_url": "https://www.nasa.gov/",
      "enabled": true
    },
    {
      "id": "noaa",
      "name": "NOAA",
      "base_url": "https://www.noaa.gov/",
      "enabled": true
    },
    {
      "id": "usgs",
      "name": "U.S. Geological Survey",
      "base_url": "https://www.usgs.gov/",
      "enabled": true
    },
    {
      "id": "nist",
      "name": "National Institute of Standards and Technology",
      "base_url": "https://www.nist.gov/",
      "enabled": true
    },
    {
      "id": "nih",
      "name": "National Institutes of Health",
      "base_url": "https://www.nih.gov/",
      "enabled": true
    },
    {
      "id": "cdc",
      "name": "Centers for Disease Control and Prevention",
      "base_url": "https://www.cdc.gov/",
      "enabled": true
    },
    {
      "id": "census",
      "name": "U.S. Census Bureau",
      "base_url": "https://www.census.gov/",
      "enabled": true
    }
  ]
}
