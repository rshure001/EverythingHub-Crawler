# Copy to .env on the private host. Never commit real credentials.
# Use long random URL-safe values (letters and numbers) for both passwords.
EH_DB_PASSWORD=replace-with-a-long-random-admin-secret
EH_SEARCH_DB_PASSWORD=replace-with-a-different-long-random-url-safe-secret
EH_SEARCH_API_TOKEN=replace-with-a-third-long-random-secret

# Admin-only URL for controlled, additive repository/catalog imports.
# Do not use this URL in the public search API.
DATABASE_URL=postgresql://everythinghub:replace-with-a-long-random-admin-secret@127.0.0.1:55432/everythinghub
