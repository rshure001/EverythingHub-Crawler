{
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "https://raw.githubusercontent.com/rshure001/EverythingHub-Crawler/main/vercel-homepage/assets/:path*"
    },
    {
      "source": "/public-search/:path*",
      "destination": "https://raw.githubusercontent.com/rshure001/EverythingHub-Crawler/main/public-search/:path*"
    },
    {
      "source": "/api/search-catalog",
      "destination": "https://everythinghub-search-backend-ne0fd5nys-rshure001-8053.vercel.app/api/search"
    },
    {
      "source": "/api/independent-search",
      "destination": "https://everythinghub-search-backend-ne0fd5nys-rshure001-8053.vercel.app/api/search"
    },
    {
      "source": "/api/media-search",
      "destination": "https://everythinghub-search-backend-ne0fd5nys-rshure001-8053.vercel.app/api/images"
    },
    {
      "source": "/api/videos",
      "destination": "https://everythinghub-search-backend-ne0fd5nys-rshure001-8053.vercel.app/api/videos"
    },
    {
      "source": "/api/news",
      "destination": "https://everythinghub-search-backend-ne0fd5nys-rshure001-8053.vercel.app/api/news"
    },
    {
      "source": "/api/search-fast",
      "destination": "https://everythinghub-search-backend-ne0fd5nys-rshure001-8053.vercel.app/api/search-fast"
    },
    {
      "source": "/api/health",
      "destination": "https://everythinghub-search-backend-ne0fd5nys-rshure001-8053.vercel.app/api/health"
    },
    {
      "source": "/topics",
      "destination": "/discover/"
    },
    {
      "source": "/topics/",
      "destination": "/discover/"
    },
    {
      "source": "/topics/:topic",
      "destination": "/discover/:topic/"
    },
    {
      "source": "/topics/:topic/",
      "destination": "/discover/:topic/"
    },
    {
      "source": "/topics/:topic/:category",
      "destination": "/discover/:topic/:category/"
    },
    {
      "source": "/topics/:topic/:category/",
      "destination": "/discover/:topic/:category/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
