{
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "https://raw.githubusercontent.com/rshure001/EverythingHub-Crawler/main/assets/:path*"
    },
    {
      "source": "/public-search/:path*",
      "destination": "https://raw.githubusercontent.com/rshure001/EverythingHub-Crawler/main/public-search/:path*"
    },
    {
      "source": "/api/search-catalog",
      "destination": "https://vdceayvfgkwpgwixrhwi.supabase.co/functions/v1/everything-hub-web-search"
    },
    {
      "source": "/api/independent-search",
      "destination": "https://vdceayvfgkwpgwixrhwi.supabase.co/functions/v1/everything-hub-independent-search"
    },
    {
      "source": "/api/media-search",
      "destination": "https://vdceayvfgkwpgwixrhwi.supabase.co/functions/v1/everything-hub-media-search"
    },
    {
      "source": "/topics",
      "destination": "https://vdceayvfgkwpgwixrhwi.supabase.co/functions/v1/everything-hub-site/topics/"
    },
    {
      "source": "/topics/",
      "destination": "https://vdceayvfgkwpgwixrhwi.supabase.co/functions/v1/everything-hub-site/topics/"
    },
    {
      "source": "/topics/:topic",
      "destination": "https://vdceayvfgkwpgwixrhwi.supabase.co/functions/v1/everything-hub-site/topics/:topic/"
    },
    {
      "source": "/topics/:topic/",
      "destination": "https://vdceayvfgkwpgwixrhwi.supabase.co/functions/v1/everything-hub-site/topics/:topic/"
    },
    {
      "source": "/topics/:topic/:category",
      "destination": "https://vdceayvfgkwpgwixrhwi.supabase.co/functions/v1/everything-hub-site/topics/:topic/:category/"
    },
    {
      "source": "/topics/:topic/:category/",
      "destination": "https://vdceayvfgkwpgwixrhwi.supabase.co/functions/v1/everything-hub-site/topics/:topic/:category/"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://vdceayvfgkwpgwixrhwi.supabase.co/functions/v1/everything-hub-site/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://vdceayvfgkwpgwixrhwi.supabase.co/functions/v1/everything-hub-site/robots.txt"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
